# ==============================================================================
# UniShare Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and populate with your credentials.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (Default):
# DATABASE_URL=sqlite:///./backend/unishare.db

# Supabase PostgreSQL (Remote Staging / Production):
# IMPORTANT for Supabase:
# - Use Session Pooling (port 5432) or direct connection when running Alembic migrations.
# - Use Transaction Pooling (port 6543) for the running FastAPI web application.
# Format: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./backend/unishare.db

# Connection Pool Settings (applicable to PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 2. Document Storage Abstraction
# ------------------------------------------------------------------------------
# Storage driver: 'local' (default) or 'supabase'
STORAGE_BACKEND=local

# Local Storage Paths (used when STORAGE_BACKEND=local)
STORAGE_DIR=./backend/storage/uploads
SUBMISSIONS_DIR=./backend/storage/submissions

# Supabase Credentials (server-side only, NEVER expose to browser)
# Required when STORAGE_BACKEND=supabase
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
# Modern Supabase Secret Key (preferred: sb_secret_...) or legacy service_role key (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_[YOUR_SECRET_KEY]

# Private Bucket Names (both buckets must be marked 'Private' in Supabase dashboard)
SUPABASE_PENDING_BUCKET=pending-submissions
SUPABASE_APPROVED_BUCKET=approved-resources

# Staged file retention policy in days (for approved submissions audit trail)
STAGED_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 3. Security, Rate Limiting & Abuse Prevention
# ------------------------------------------------------------------------------
# Cloudflare Turnstile bot protection for note contribution
CF_TURNSTILE_SITE_KEY=[YOUR_TURNSTILE_SITE_KEY]
CF_TURNSTILE_SECRET_KEY=[YOUR_TURNSTILE_SECRET_KEY]

# Centralized Redis connection (optional, for multi-worker rate limiting)
# REDIS_URL=rediss://default:[PASSWORD]@[HOST]:6379

# ------------------------------------------------------------------------------
# 4. Maintainer Notifications
# ------------------------------------------------------------------------------
# Discord webhook alerts when students submit new materials for review
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/[WEBHOOK_ID]/[WEBHOOK_TOKEN]

# ------------------------------------------------------------------------------
# 5. CORS Origins
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
